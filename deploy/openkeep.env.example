# OpenKeep -- variáveis de produção (lido pela unit systemd via EnvironmentFile).
#
# Instale em /etc/openkeep/openkeep.env com dono root:root e permissão 600
# (o systemd lê como root antes de baixar privilégio para o usuário 'openkeep').
#
#   sudo install -d -o root -g root -m 0750 /etc/openkeep
#   sudo cp deploy/openkeep.env.example /etc/openkeep/openkeep.env
#   sudo chmod 600 /etc/openkeep/openkeep.env
#   # edite e preencha os segredos abaixo

# --- Obrigatórias ---------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=54322
LOG_LEVEL=info

# Origem pública EXATA onde o app é acessado (o hostname do Cloudflare Tunnel).
# Precisa bater com o que o browser vê; começa com https:// para cookies Secure.
APP_URL=https://openkeep.cepify.com.br

# Conexão com o PostgreSQL local (database e role dedicados ao OpenKeep).
# Gere a senha com: openssl rand -hex 24
DATABASE_URL=postgres://openkeep:TROQUE_A_SENHA@127.0.0.1:5432/openkeep

# Segredo de assinatura de sessão do Better Auth (mínimo 32 chars).
# Gere com: openssl rand -base64 33
BETTER_AUTH_SECRET=TROQUE_ESTE_SEGREDO_MIN_32_CHARS

# Diretórios (o storage precisa ser gravável pelo usuário 'openkeep').
STORAGE_DIR=/var/lib/openkeep
WEB_DIST_DIR=/opt/openkeep/web-dist

# --- Web Push (lembretes) -------------------------------------------------------
# Gere um par com:  node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# --- OAuth (opcional; cada par é tudo-ou-nada) ----------------------------------
# Callbacks: https://SEU_DOMINIO/api/auth/callback/google
#            https://SEU_DOMINIO/api/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- E-mail (opcional; reset de senha) ------------------------------------------
# SMTP_URL=smtps://usuario:senha@smtp.provedor.com:465
# SMTP_FROM=OpenKeep <no-reply@seu-dominio>
