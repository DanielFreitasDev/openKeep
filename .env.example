# --- Required -----------------------------------------------------------
# Postgres connection string (compose.dev.yml exposes it on localhost:55432)
DATABASE_URL=postgres://openkeep:openkeep@localhost:55432/openkeep

# Secret used to sign sessions. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 33
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Public origin the app is reached at (the SPA origin).
# Dev: the Vite dev server. Prod: your reverse-proxy origin, e.g. https://keep.example.com
APP_URL=http://localhost:5173

# --- Optional ------------------------------------------------------------
# API server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Directory where uploaded attachments / export zips are stored
STORAGE_DIR=./storage

# Accounts that get the Administration panel (gear menu): instance totals, disk
# use per account, the "allow new accounts" switch and account deletion. Unset
# means nobody does and the panel does not exist. This is the only way to grant
# it — nothing inside the app can. See docs/DEPLOYMENT.md.
# ADMIN_EMAILS=you@example.com,ops@example.com

# Megabytes of attachments one account may own (images, audio, drawings and
# files, trash included). Unset means no ceiling — the usual answer for a
# single-user instance. The Settings dialog shows usage against it, and an
# upload past it is refused with a message that says so.
# USER_STORAGE_QUOTA_MB=2048

# Days a trashed note survives before the hourly purge deletes it for good.
# Keep parity is 7; the Trash banner states whatever you set here.
TRASH_RETENTION_DAYS=7

# OAuth sign-in (enabled only when both values of a pair are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Password-reset email (graceful degradation: reset is hidden when unset)
# e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
SMTP_FROM=

# Web Push (reminder notifications). Generate with: pnpm --filter @openkeep/server gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Built SPA directory served by the API in production (the Docker image sets
# this; unset in dev — Vite serves the SPA).
# WEB_DIST_DIR=/app/web-dist

# Prometheus metrics at GET /metrics (the route does not exist while this is
# off). Set METRICS_TOKEN (>=16 chars) to require `Authorization: Bearer <token>`
# — otherwise keep /metrics off your public listener. See docs/DEPLOYMENT.md.
# METRICS_ENABLED=false
# METRICS_TOKEN=

# Scheduled backups: one export archive per account under BACKUP_DIR/<userId>/,
# keeping the newest BACKUP_KEEP. Without BACKUP_CRON (5-field cron) the job is
# never registered. Point BACKUP_DIR at a writable volume — and read the
# "Scheduled backups and restoring" section of docs/DEPLOYMENT.md: an archive
# restores notes, not attachments or sharing. It does not replace pg_dump.
# BACKUP_CRON=0 4 * * *
# BACKUP_DIR=./backups
# BACKUP_KEEP=7

# Outgoing webhooks (Settings → Webhooks) need no env var to work. Set this
# only if your endpoints live on the LAN or on loopback — Home Assistant, a
# container next door, n8n at home. Left off, deliveries go through the same
# SSRF guard as link previews and private addresses are refused, which is what
# a multi-user instance wants. See docs/DEPLOYMENT.md.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false
