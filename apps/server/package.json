{
  "name": "@openkeep/server",
  "version": "0.0.0",
  "private": true,
  "description": "OpenKeep API server (Fastify + Drizzle + pg-boss)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "gen:vapid": "tsx scripts/gen-vapid.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/swagger": "9.8.1",
    "@fastify/websocket": "11.3.0",
    "@openkeep/shared": "workspace:*",
    "archiver": "8.0.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "pg-boss": "12.26.3",
    "pino": "10.3.1",
    "rrule": "2.8.1",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "undici": "8.9.0",
    "web-push": "3.6.7",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fastify/swagger-ui": "6.1.0",
    "@openkeep/config": "workspace:*",
    "@testcontainers/postgresql": "12.0.4",
    "@types/archiver": "8.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/sanitize-html": "2.16.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "ws": "8.21.1"
  }
}
