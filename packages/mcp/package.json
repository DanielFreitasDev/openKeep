{
  "name": "@openkeep/mcp",
  "version": "1.8.1",
  "private": true,
  "description": "MCP server exposing the full OpenKeep API to AI assistants",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "openkeep-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/stdio.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@openkeep/shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@openkeep/config": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
